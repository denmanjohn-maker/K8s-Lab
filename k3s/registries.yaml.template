# /etc/rancher/k3s/registries.yaml — rendered by k3s/10-trust-harbor-ca.sh, one copy per node.
# K3s turns this into containerd hosts.toml under /var/lib/rancher/k3s/agent/etc/containerd/certs.d/.
# Docs: https://docs.k3s.io/installation/private-registry
mirrors:
  "${HARBOR_HOST}":
    endpoint:
      - "https://${HARBOR_HOST}"
${DOCKERHUB_MIRROR_BLOCK}
configs:
  "${HARBOR_HOST}":
    auth:
      username: "${ROBOT_USER}"
      password: "${ROBOT_TOKEN}"
    tls:
      ca_file: /etc/rancher/k3s/kubernetes-lab-ca.crt

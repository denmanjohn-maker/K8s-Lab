# /etc/rancher/k3s/registries.yaml — rendered by k3s/10-render-registries.sh to secrets/registries.yaml
# and bind-mounted into every k3d node. K3s turns it into containerd hosts.toml under
# /var/lib/rancher/k3s/agent/etc/containerd/certs.d/.   Docs: https://docs.k3s.io/installation/private-registry
mirrors:
  "${HARBOR_HOST}":
    endpoint:
      - "https://${HARBOR_HOST}"
${DOCKERHUB_MIRROR_BLOCK}
configs:
  "${HARBOR_HOST}":
    auth:
      username: "${ROBOT_USER}"
      password: "${ROBOT_TOKEN}"
    tls:
      ca_file: /etc/ssl/certs/kubernetes-lab-ca.crt   # mounted by k3s/k3d-config.yaml.template
